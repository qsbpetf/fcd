<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Contact_Owner_Email_Notification</name>
        <label>Send Contact Owner Email Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Contact.Contact_Owner_Assignment_Email</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Contact.Contact_Owner_Assignment_Email</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <description>Email the new owner when a Contact is created with a user owner or reassigned. Any source. Integration user and self-assignments are excluded.</description>
    <environments>Default</environments>
    <interviewLabel>Contact Owner Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact Owner Notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Contact_Owner_Email_Notification</targetReference>
        </connector>
        <filterFormula>BEGINS({!$Record.OwnerId}, &quot;005&quot;)
&amp;&amp; (ISNEW() || ISCHANGED({!$Record.OwnerId}))
&amp;&amp; {!$Record.OwnerId} &lt;&gt; &quot;0050Y0000039oIfQAI&quot;
&amp;&amp; {!$Record.OwnerId} &lt;&gt; {!$User.Id}</filterFormula>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
