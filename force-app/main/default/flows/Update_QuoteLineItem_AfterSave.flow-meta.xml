    <decisions>
        <name>Needs_Update</name>
        <label>Values Out of Sync?</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Already In Sync - No DML</defaultConnectorLabel>
        <rules>
            <name>Out_of_Sync</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>Get_QLI.TotalPrice</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_QLI.Total_Price__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_QLI.TotalPrice</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_QLI.Final_Price_After_Discount__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>formula_Final_Price</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_QLI</targetReference>
            </connector>
            <label>Out of Sync</label>
        </rules>
    </decisions>
    <description>Replacement for Process Builder  &quot;Update QuoteLineItem (Create and Edit)&quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_Final_Price</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Get_QLI.Discount__c}), {!Get_QLI.TotalPrice}, {!Get_QLI.TotalPrice} - ({!Get_QLI.TotalPrice} * ({!Get_QLI.Discount__c} / 100)))</expression>
        <scale>2</scale>
    </formulas>
