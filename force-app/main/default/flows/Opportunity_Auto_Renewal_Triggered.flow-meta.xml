                <elementReference>forOpportunityProductEndDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varOpportunityProduct.Renewal__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Renewal (CV Owned)</stringValue>
            </value>
