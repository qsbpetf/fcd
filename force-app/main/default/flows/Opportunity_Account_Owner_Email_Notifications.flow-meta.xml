        <label>Send_Closed_Won_Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Opportunity.Opp_Won_Notify_Account_Owner_v2</actionName>
        <actionType>emailAlert</actionType>
