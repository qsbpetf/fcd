<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_change_past_pound_exchange_rate</fullName>
    <active>true</active>
    <errorConditionFormula>(Start_Date__c &lt;TODAY() &amp;&amp; ISCHANGED( Exchange_Rate_from_USD_to_GBP__c )) &amp;&amp; $Setup.rh2__PS_Settings__c.rh2__Run_Validation_Rule__c</errorConditionFormula>
    <errorDisplayField>Exchange_Rate_from_USD_to_GBP__c</errorDisplayField>
    <errorMessage>Sorry, you can&apos;t change the exchange rate once the start date is past.</errorMessage>
</ValidationRule>
